# ---------------------------------------------------------------------------
# Configuracion del sistema RECAUDO-T. Ningun valor esta escrito en el codigo.
# ---------------------------------------------------------------------------

# --- Monitor Ping/Echo (R1) ---
MONITOR_T_MS=1000          # T: periodo de sondeo (1 s)
MONITOR_TIMEOUT_MS=300     # t: tiempo maximo de espera del eco (300 ms)
MONITOR_K=2                # k: fallos consecutivos para marcar CAIDA
MONITOR_M=2                # m: exitos consecutivos para volver a VIVA
MONITOR_TRAZA=false        # true = imprime cada ping (depuracion)
ESTADO_INICIAL=VIVA        # estado con el que arrancan las replicas

# --- Redundancia activa (R2) ---
# Agregar una replica es agregarla a esta lista (y al docker-compose.yml):
# el codigo del dispatcher NO cambia.
REPLICAS=A=http://replica-a:8080,B=http://replica-b:8080,C=http://replica-c:8080
CONSULTA_TIMEOUT_MS=1500   # tiempo maximo de la carrera entre replicas

# --- Replicas ---
LATENCIA_MIN_MS=2          # latencia artificial minima de /saldo
LATENCIA_MAX_MS=25         # latencia artificial maxima de /saldo
SALDO_BASE=15000

# --- Puertos publicados en el host ---
PUERTO_DISPATCHER=8080
PUERTO_REPLICA_A=8081
PUERTO_REPLICA_B=8082
PUERTO_REPLICA_C=8083
PUERTO_FRONTEND=3000
DISPATCHER_URL_PUBLICA=http://localhost:8080

# --- Cliente generador de carga ---
TASA_RPS=20                # 20 solicitudes/s
DURACION_S=40              # al menos 40 s de carga
ID_TARJETA=1234
ETIQUETA=E0                # E0 / E1: identifica el experimento en el CSV
ARCHIVO_CSV=cliente.csv
CLIENTE_TIMEOUT_MS=2000

# --- Inyector de fallas ---
OBJETIVO=recaudo-replica-b
MODO_INYECTOR=docker       # docker | http
COMANDO_DOCKER=kill        # kill | stop
