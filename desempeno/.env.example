# ---------------------------------------------------------------------------
# Configuracion del taller de tacticas de desempeno. Ningun valor esta escrito
# en el codigo: cambiar de experimento es cambiar estas variables.
#
# Los valores por defecto son los de E0 (la linea base con el problema).
# ---------------------------------------------------------------------------

# --- R1: Introducir Concurrencia ---
TRABAJADORES=1             # W: cuantos calculos corren a la vez (E0=1, E1/E2=8)
COLA_MAX=256               # solicitudes que pueden esperar turno antes de rechazar

# --- R2: Mantener Multiples Copias de Datos (cache) ---
CACHE_ACTIVA=false         # E0 y E1 = false; E2 = true

# --- Calculo costoso ---
COSTO_CALCULO_MS=200       # duracion fija de un resumen calculado
VIAJES_POR_DEFECTO=40      # N usado cuando la consulta no trae ?viajes=

# --- Trazas (docker compose logs) ---
LOG_PETICIONES=true        # una linea por consulta atendida (cache=HIT/MISS)
LOG_VIGILANCIA=false       # incluir el trafico de inspeccion: /config y /salud

# --- Puerto publicado en el host ---
# 8090 para no chocar con el taller de disponibilidad, que usa 8080.
PUERTO_SERVIDOR=8090
SERVIDOR_URL_PUBLICA=http://localhost:8090

# --- Cliente generador de rafaga ---
TASA_RPS=8                 # 8 solicitudes/s
DURACION_S=16              # 8 x 16 = 128 solicitudes (el taller pide >= 100 en 15-20 s)
NUM_TARJETAS=10            # conjunto pequeno para que el cache tenga oportunidad
TARJETA_BASE=1000          # tarjetas 1000..1009
VIAJES=40                  # viajes que se piden por resumen
ETIQUETA=E0                # E0 / E1 / E2: identifica el experimento en el CSV
ARCHIVO_CSV=cliente.csv
CLIENTE_TIMEOUT_MS=3000    # mas alla de 3 s = evento no procesado
